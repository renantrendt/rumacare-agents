# Ruma Care voice agent - LiveKit edition
#
# Copy this file to ../.env.local and fill in real values. The agent loads
# from the parent directory's .env.local so secrets stay in one place.
#
# DO NOT COMMIT real credentials. .env.local is gitignored at repo root.

# ─────────────────────────────────────────────
# LiveKit Cloud — control plane + WebRTC SFU + SIP gateway
# Console: https://cloud.livekit.io
# Project → Settings → API Keys
# ─────────────────────────────────────────────
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# SIP outbound trunk ID (from `lk sip outbound list` after creating the trunk)
# This trunk is bound to a Twilio Elastic SIP Trunk on the Twilio side.
SIP_OUTBOUND_TRUNK_ID=ST_REPLACE_ME

# ─────────────────────────────────────────────
# Twilio — provides the Elastic SIP Trunk that LiveKit dials through
# Console: https://console.twilio.com
# Note: in the LiveKit edition, Twilio is ONLY used as a SIP carrier.
# We don't use Programmable Voice / TwiML / Media Streams anymore.
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
# The number we use as caller-ID on outbound SIP calls (must be owned/verified)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─────────────────────────────────────────────
# Deepgram — streaming ASR (used via livekit-plugins-deepgram)
# Console: https://console.deepgram.com
# ─────────────────────────────────────────────
DEEPGRAM_API_KEY=REPLACE_ME

# ─────────────────────────────────────────────
# OpenAI - GPT-Realtime-2 primary model path
# https://platform.openai.com/api-keys
# ─────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_ME

# ─────────────────────────────────────────────
# Anthropic - optional LLM judge for scoring soft checks
# https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=REPLACE_ME
JUDGE_MODEL=anthropic/claude-opus-4-7
