# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit live keys.

# ─────────────────────────────────────────────
# LiveKit Cloud - control plane + WebRTC SFU + SIP gateway
# Console: https://cloud.livekit.io
# ─────────────────────────────────────────────
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<REPLACE_ME>
LIVEKIT_API_SECRET=<REPLACE_ME>
SIP_OUTBOUND_TRUNK_ID=ST_<REPLACE_ME>

# ─────────────────────────────────────────────
# Twilio - Elastic SIP Trunk carrier
# Console: https://console.twilio.com
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─────────────────────────────────────────────
# Deepgram - mock IVR TTS/STT and cascaded fallback
# Console: https://console.deepgram.com
# ─────────────────────────────────────────────
DEEPGRAM_API_KEY=REPLACE_ME

# ─────────────────────────────────────────────
# GPT-Realtime-2 primary path
# Console: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_ME

# ─────────────────────────────────────────────
# Optional model/judge providers
# ─────────────────────────────────────────────
GROQ_API_KEY=REPLACE_ME
XAI_API_KEY=REPLACE_ME
ANTHROPIC_API_KEY=REPLACE_ME
JUDGE_MODEL=anthropic/claude-opus-4-7
